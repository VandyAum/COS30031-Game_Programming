; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

; Follow-up prompt (AI-assisted, Claude Opus 5.5): "Name the game, register the Sfx autoload,
; name the 2D physics layers (barriers, vehicles, debris, incident_zones, crew_sensors), set
; top-down physics (no gravity, damping set per debris type), and don't force fullscreen on web."

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="The Race Against Time"
config/description="Dispatch emergency crews across a map that goes stale. A COS30031 prototype for the DTP Vicmap Game Challenge."
run/main_scene="uid://vu3o5p5e144v"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

Events="*res://Script/Autoload/events.gd"
Stage="*res://Script/Autoload/stage.gd"
RoadGraph="*res://Script/Autoload/road_graph.gd"
World="*res://Script/Autoload/world.gd"
Knowledge="*res://Script/Autoload/knowledge.gd"
Run="*res://Script/Autoload/run.gd"
Sfx="*res://Script/Autoload/sfx.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=3
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/size/mode.web=0

[gui]

theme/custom="res://UI/game_theme.tres"

