extends Node3D

## First-pass 3D greybox built from the existing generated map data.
## The source files under Map/world are generated by tools/build_world.py;
## this script only reads them and does not modify the 2D map pipeline.

const META_PATH := "res://Map/world/world_meta.json"
const AREAS_PATH := "res://Map/world/areas.json"
const ROADS_PATH := "res://Map/world/roads.json"
const BUILDINGS_PATH := "res://Map/world/buildings.bin"
const ROAD_WIDTH_PX := [7.0, 9.0, 12.0, 15.0]
const BUILDING_HEIGHTS_M := [6.0, 9.0, 12.0, 8.0]

var _world_size_px := Vector2.ZERO
## Use the centre of the tutorial stage (Cambermere Junction) as 3D origin.
var _map_origin_px := Vector2.ZERO
var _pixels_per_metre := 0.75
var _vertices := PackedVector3Array()


func _ready() -> void:
	_build_city()


func _build_city() -> void:
	var meta := _read_json(META_PATH)
	var areas := _read_json(AREAS_PATH)
	var roads := _read_json(ROADS_PATH)
	if meta.is_empty() or areas.is_empty() or roads.is_empty():
		push_error("CityMap3D: generated map data is missing or invalid.")
		return

	_world_size_px = Vector2(float(meta["size"][0]), float(meta["size"][1]))
	_pixels_per_metre = float(meta["px_per_m"])
	var stage_rects: Array = meta.get("stage_rects", [])
	if not stage_rects.is_empty() and stage_rects[0] is Array and stage_rects[0].size() >= 4:
		_map_origin_px = Vector2(
			(float(stage_rects[0][0]) + float(stage_rects[0][2])) * 0.5,
			(float(stage_rects[0][1]) + float(stage_rects[0][3])) * 0.5
		)
	else:
		push_error("CityMap3D: world_meta.json has no tutorial stage rectangle for the map origin.")
		return
	if _pixels_per_metre <= 0.0:
		push_error("CityMap3D: world_meta.json has an invalid px_per_m value.")
		return

	_add_ground()
	_add_polygon_layer("Water", areas.get("water", []), Color("91b9c9"), 0.03)
	_add_polygon_layer("Parks", areas.get("parks", []), Color("a9b59a"), 0.05)
	_add_roads(roads.get("edges", []))
	_add_line_layer("Waterways", areas.get("waterways", []), Color("789eaf"), 3.0)
	_add_line_layer("Rail", _as_lines(areas.get("rail", [])), Color("777777"), 1.8)
	if FileAccess.file_exists(BUILDINGS_PATH):
		_add_binary_buildings()
	else:
		_add_buildings(areas.get("footprints", []))
	print("CityMap3D: greybox built from generated map data.")


func _read_json(path: String) -> Dictionary:
	if not FileAccess.file_exists(path):
		push_error("CityMap3D: cannot find %s" % path)
		return {}
	var parsed: Variant = JSON.parse_string(FileAccess.get_file_as_string(path))
	if parsed is Dictionary:
		return parsed
	push_error("CityMap3D: could not parse %s" % path)
	return {}


func _add_ground() -> void:
	var plane := PlaneMesh.new()
	plane.size = Vector2(_world_size_px.x / _pixels_per_metre, _world_size_px.y / _pixels_per_metre)
	var ground := MeshInstance3D.new()
	ground.name = "Ground"
	ground.mesh = plane
	ground.position = map_position_to_world(_world_size_px * 0.5)
	ground.material_override = _material(Color("b9b9b5"))
	add_child(ground)


func _add_polygon_layer(layer_name: String, polygons: Array, colour: Color, height: float) -> void:
	_vertices.clear()
	for raw_polygon in polygons:
		var points := _polygon_points(raw_polygon)
		if points.size() < 3 or not _centroid_is_inside(points):
			continue
		var triangles := Geometry2D.triangulate_polygon(points)
		for i in range(0, triangles.size(), 3):
			_vertices.append(map_position_to_world(points[triangles[i]], height))
			_vertices.append(map_position_to_world(points[triangles[i + 1]], height))
			_vertices.append(map_position_to_world(points[triangles[i + 2]], height))
	_add_mesh(layer_name, colour)


func _add_roads(edges: Array) -> void:
	_vertices.clear()
	for edge in edges:
		var points := _polygon_points(edge.get("pts", []))
		var road_class := clampi(int(edge.get("c", 0)), 0, ROAD_WIDTH_PX.size() - 1)
		var width_m: float = float(ROAD_WIDTH_PX[road_class]) / _pixels_per_metre
		for i in range(points.size() - 1):
			var a := map_position_to_world(points[i], 0.09)
			var b := map_position_to_world(points[i + 1], 0.09)
			var direction := Vector2(b.x - a.x, b.z - a.z).normalized()
			if direction.is_zero_approx():
				continue
			var side := Vector3(-direction.y, 0.0, direction.x) * width_m * 0.5
			_append_quad(a - side, a + side, b + side, b - side)
	_add_mesh("Roads", Color("74777a"))
	_add_road_click_collider()


func _add_road_click_collider() -> void:
	if _vertices.is_empty():
		return
	var shape := ConcavePolygonShape3D.new()
	shape.set_faces(_vertices)
	var shape_node := CollisionShape3D.new()
	shape_node.name = "RoadClickShape"
	shape_node.shape = shape
	var body := StaticBody3D.new()
	body.name = "RoadClickTarget"
	body.collision_layer = 1 << 6 # Named click_targets layer 7.
	body.collision_mask = 0
	body.add_child(shape_node)
	add_child(body)


func _add_line_layer(layer_name: String, lines: Array, colour: Color, width_m: float) -> void:
	_vertices.clear()
	for line_data in lines:
		var points: Array = line_data.get("pts", []) if line_data is Dictionary else line_data
		var map_points := _polygon_points(points)
		var line_width := float(line_data.get("w", width_m)) / _pixels_per_metre if line_data is Dictionary else width_m
		for i in range(map_points.size() - 1):
			var a := map_position_to_world(map_points[i], 0.12)
			var b := map_position_to_world(map_points[i + 1], 0.12)
			var direction := Vector2(b.x - a.x, b.z - a.z).normalized()
			if direction.is_zero_approx():
				continue
			var side := Vector3(-direction.y, 0.0, direction.x) * line_width * 0.5
			_append_quad(a - side, a + side, b + side, b - side)
	_add_mesh(layer_name, colour)


func _add_buildings(polygons: Array) -> void:
	_vertices.clear()
	for raw_polygon in polygons:
		var points := _polygon_points(raw_polygon)
		if points.size() < 3 or not _centroid_is_inside(points):
			continue
		var triangles := Geometry2D.triangulate_polygon(points)
		for i in range(0, triangles.size(), 3):
			_vertices.append(map_position_to_world(points[triangles[i]], BUILDING_HEIGHTS_M[0]))
			_vertices.append(map_position_to_world(points[triangles[i + 1]], BUILDING_HEIGHTS_M[0]))
			_vertices.append(map_position_to_world(points[triangles[i + 2]], BUILDING_HEIGHTS_M[0]))
		for i in points.size():
			var next := (i + 1) % points.size()
			var bottom_a := map_position_to_world(points[i], 0.08)
			var bottom_b := map_position_to_world(points[next], 0.08)
			var top_a := map_position_to_world(points[i], BUILDING_HEIGHTS_M[0])
			var top_b := map_position_to_world(points[next], BUILDING_HEIGHTS_M[0])
			_append_quad(bottom_a, bottom_b, top_b, top_a)
	_add_mesh("Buildings", Color("9b9b98"))


func _add_binary_buildings() -> void:
	var data := FileAccess.get_file_as_bytes(BUILDINGS_PATH)
	var building_vertices: Array = [[], [], [], []]
	var site_vertices: Array = [[], [], [], []]
	var offset := 0
	while offset < data.size():
		if offset + 3 > data.size():
			push_error("CityMap3D: buildings.bin ends inside a record header.")
			return
		var kind := int(data[offset])
		var triangle_count := int(data.decode_u16(offset + 1))
		offset += 3
		var record_bytes := triangle_count * 12
		if kind > 7 or offset + record_bytes > data.size():
			push_error("CityMap3D: buildings.bin contains an invalid record.")
			return

		var category := kind % 4
		var is_site := kind >= 4
		var edge_counts: Dictionary = {}
		var edge_points: Dictionary = {}
		for _triangle_index in triangle_count:
			var a := Vector2i(data.decode_s16(offset), data.decode_s16(offset + 2))
			var b := Vector2i(data.decode_s16(offset + 4), data.decode_s16(offset + 6))
			var c := Vector2i(data.decode_s16(offset + 8), data.decode_s16(offset + 10))
			offset += 12
			if is_site:
				_append_triangle_to(site_vertices[category], map_position_to_world(Vector2(a), 0.06), map_position_to_world(Vector2(b), 0.06), map_position_to_world(Vector2(c), 0.06))
			else:
				var building_height: float = float(BUILDING_HEIGHTS_M[category])
				_append_triangle_to(building_vertices[category], map_position_to_world(Vector2(a), building_height), map_position_to_world(Vector2(b), building_height), map_position_to_world(Vector2(c), building_height))
				_record_edge(edge_counts, edge_points, a, b)
				_record_edge(edge_counts, edge_points, b, c)
				_record_edge(edge_counts, edge_points, c, a)

		if not is_site:
			for edge_key in edge_counts:
				if edge_counts[edge_key] != 1:
					continue
				var ends: Array = edge_points[edge_key]
				var building_height: float = float(BUILDING_HEIGHTS_M[category])
				var bottom_a := map_position_to_world(Vector2(ends[0]), 0.08)
				var bottom_b := map_position_to_world(Vector2(ends[1]), 0.08)
				var top_a := map_position_to_world(Vector2(ends[0]), building_height)
				var top_b := map_position_to_world(Vector2(ends[1]), building_height)
				_append_quad_to(building_vertices[category], bottom_a, bottom_b, top_b, top_a)

	var building_colours := [Color("8f9291"), Color("999b99"), Color("a5a6a3"), Color("858987")]
	var site_colours := [Color("c9c7bd"), Color("d0c8cc"), Color("c7cbd0"), Color("c9c5b9")]
	for category in 4:
		_add_mesh_from_array("Buildings_%d" % category, building_vertices[category], building_colours[category])
		_add_mesh_from_array("Sites_%d" % category, site_vertices[category], site_colours[category])


func _record_edge(counts: Dictionary, endpoints: Dictionary, a: Vector2i, b: Vector2i) -> void:
	var first := a
	var second := b
	if first.x > second.x or (first.x == second.x and first.y > second.y):
		first = b
		second = a
	var key := "%d,%d|%d,%d" % [first.x, first.y, second.x, second.y]
	counts[key] = int(counts.get(key, 0)) + 1
	if not endpoints.has(key):
		endpoints[key] = [first, second]


func _polygon_points(raw_points: Array) -> PackedVector2Array:
	var points := PackedVector2Array()
	for raw_point in raw_points:
		if raw_point is Array and raw_point.size() >= 2:
			points.append(Vector2(float(raw_point[0]), float(raw_point[1])))
	if points.size() > 2 and points[0].distance_to(points[-1]) < 0.01:
		points.remove_at(points.size() - 1)
	return points


func _centroid_is_inside(points: PackedVector2Array) -> bool:
	var centre := Vector2.ZERO
	for point in points:
		centre += point
	centre /= float(points.size())
	return centre.x >= 0.0 and centre.y >= 0.0 and centre.x <= _world_size_px.x and centre.y <= _world_size_px.y


func map_position_to_world(point: Vector2, height: float = 0.0) -> Vector3:
	return Vector3(
		(point.x - _map_origin_px.x) / _pixels_per_metre,
		height,
		(point.y - _map_origin_px.y) / _pixels_per_metre
	)


func world_position_to_map(world_point: Vector3) -> Vector2:
	return Vector2(
		world_point.x * _pixels_per_metre + _map_origin_px.x,
		world_point.z * _pixels_per_metre + _map_origin_px.y
	)


func map_origin_position() -> Vector2:
	return _map_origin_px


func _append_quad(a: Vector3, b: Vector3, c: Vector3, d: Vector3) -> void:
	_vertices.append(a)
	_vertices.append(b)
	_vertices.append(c)
	_vertices.append(a)
	_vertices.append(c)
	_vertices.append(d)


func _append_triangle_to(target: Array, a: Vector3, b: Vector3, c: Vector3) -> void:
	target.append(a)
	target.append(b)
	target.append(c)


func _append_quad_to(target: Array, a: Vector3, b: Vector3, c: Vector3, d: Vector3) -> void:
	_append_triangle_to(target, a, b, c)
	_append_triangle_to(target, a, c, d)


func _add_mesh(mesh_name: String, colour: Color) -> void:
	if _vertices.is_empty():
		return
	_add_mesh_from_array(mesh_name, _vertices, colour)


func _add_mesh_from_array(mesh_name: String, vertices: Array, colour: Color) -> void:
	if vertices.is_empty():
		return
	var arrays: Array = []
	arrays.resize(Mesh.ARRAY_MAX)
	var packed_vertices := PackedVector3Array()
	for vertex in vertices:
		packed_vertices.append(vertex)
	arrays[Mesh.ARRAY_VERTEX] = packed_vertices
	var mesh := ArrayMesh.new()
	mesh.add_surface_from_arrays(Mesh.PRIMITIVE_TRIANGLES, arrays)
	var instance := MeshInstance3D.new()
	instance.name = mesh_name
	instance.mesh = mesh
	instance.material_override = _material(colour)
	add_child(instance)


func _material(colour: Color) -> StandardMaterial3D:
	var material := StandardMaterial3D.new()
	material.shading_mode = BaseMaterial3D.SHADING_MODE_UNSHADED
	material.cull_mode = BaseMaterial3D.CULL_DISABLED
	material.albedo_color = colour
	return material


func _as_lines(raw_lines: Array) -> Array:
	var lines: Array = []
	for line in raw_lines:
		if line is Dictionary:
			lines.append(line)
		else:
			lines.append({"pts": line})
	return lines
