[gd_resource type="Resource" script_class="IncidentType" format=3]

; AI-assisted (Claude Opus 5.5): data file written from the prompt in Script/Data/incident_type.gd.
; Follow-up prompt (variety + pacing): "Add more variety so one crew type isn't the only
; failure point: car crashes don't always need an ambulance, police respond to crimes,
; fire crews fight fires from stage 1, and the SES handles storm damage."
; Follow-up prompt: "Make incidents take about 20% longer to tick down" (time limit x1.2).
; Follow-up prompt (physics + particles): "Give each incident type its debris and ambient effect."
; Designers: edit these values in the inspector.

[ext_resource type="Script" path="res://Script/Data/incident_type.gd" id="1"]

[resource]
script = ExtResource("1")
id = &"break_in"
display_name = "Break-in"
crew_types = Array[StringName]([&"police"])
resolve_seconds = 4.0
time_limit_seconds = 72.0
min_stage = 1
weight = 0.8
where = 1
road_classes = Array[int]([0])
foi_types = Array[String](["commercial facility", "residential building", "education centre", "community venue", "cultural centre", "storage facility", "admin facility"])
descriptions = Array[String](["The alarm is going off at {place} and a window has been smashed.", "Staff at {place} have arrived to find the door forced open."])
debris = Array[StringName]([&"glass"])
debris_count = 6
