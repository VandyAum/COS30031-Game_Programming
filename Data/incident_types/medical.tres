[gd_resource type="Resource" script_class="IncidentType" format=3]

; AI-assisted (Claude Opus 5.5): data file written from the prompt in Script/Data/incident_type.gd.
; Follow-up prompt: "Make incidents take about 20% longer to tick down" (time limit x1.2).
; Designers: edit these values in the inspector.

[ext_resource type="Script" path="res://Script/Data/incident_type.gd" id="1"]

[resource]
script = ExtResource("1")
id = &"medical"
display_name = "Medical emergency"
crew_types = Array[StringName]([&"ambulance"])
resolve_seconds = 5.0
time_limit_seconds = 60.0
min_stage = 0
weight = 1.0
where = 1
road_classes = Array[int]([0])
foi_types = Array[String](["care facility", "residential building", "education centre", "community venue", "commercial facility", "sport facility"])
descriptions = Array[String](["Someone has collapsed at {place}.", "An elderly resident at {place} has had a bad fall.", "A person is having trouble breathing at {place}."])
